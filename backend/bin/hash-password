#!/usr/bin/env php
<?php

declare(strict_types=1);

$password = rtrim((string) stream_get_contents(STDIN), "\r\n");

$algorithm = defined('PASSWORD_ARGON2ID') ? PASSWORD_ARGON2ID : PASSWORD_BCRYPT;
$maxBytes = $algorithm === PASSWORD_BCRYPT ? 72 : 4096;

if (strlen($password) < 12 || strlen($password) > $maxBytes || str_contains($password, "\0")) {
    fwrite(STDERR, "Password must be 12 to {$maxBytes} bytes and contain no NUL byte.\n");
    exit(1);
}

echo password_hash($password, $algorithm), "\n";
