{
    "name": "juanmafx/php-labs",
    "description": "Hardened PHP 8.4+ rewrite of three Web Applications for Everybody course exercises.",
    "version": "1.0.1",
    "type": "project",
    "require": {
        "php": ">=8.4.1",
        "ext-hash": "*",
        "ext-mbstring": "*",
        "ext-session": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": { "psr-4": { "PhpLabs\\": "backend/src/" } },
    "autoload-dev": { "psr-4": { "PhpLabs\\Tests\\": "tests/" } },
    "config": {
        "allow-plugins": false,
        "platform": { "php": "8.4.1" },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G"
    }
}
